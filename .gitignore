# Python
.venv/
**/.venv/
__pycache__/
*.pyc

# S32 Design Studio / build output
.metadata/
# S32DS build configurations (not Project_Settings/Debugger, which holds the launch files)
**/Debug_FLASH/
**/Release_FLASH/
**/Debug_RAM/
**/Release_RAM/
*.o
*.d
*.elf
*.srec
*.hex
*.bin
*.map
*.lst
*.args

# Packaged tools
software/**/execution/*.exe
software/**/execution/*.spec
software/**/build/
software/**/dist/

# IDE / OS
# VS Code: keep the shared C/C++ configuration (software/tools/gen_vscode.py), ignore the rest
**/.vscode/*
!**/.vscode/c_cpp_properties.json
!**/.vscode/settings.json
!**/.vscode/extensions.json
*.swp
*~
Thumbs.db
desktop.ini

# Office lock files
~$*

# Logs / temp
*.log
tmp/

# Local lesson materials
00_Lesson/

# EB Tresos
*.tdb
**/mcal_config/**/Build/

# S32DS regenerates the compiler discovery cache (env-hash) on every open/build
**/.settings/language.settings.xml
